HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=INFO

OIDC_ISSUER=https://auth.iisc.ac.in/auth/realms/campus
OIDC_CLIENT_ID=onprem-rag-gateway
OIDC_CLIENT_SECRET=change-me-secret-token
OIDC_JWKS_URL=https://auth.iisc.ac.in/auth/realms/campus/protocol/openid-connect/certs
OIDC_AUDIENCE=onprem-rag-gateway

ALLOWED_EMAIL_DOMAINS=iisc.ac.in
ADMIN_ROLES=cluster_admin,faculty_lead
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SESSION_SECRET=CHANGE_ME
COOKIE_SECURE=0
OTP_MAX_PER_HOUR=10
OTP_MAX_PER_IP_HOUR=1000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_INDEX_NAME=rag_documents_idx
SEMANTIC_CACHE_TTL=14400        # semantic cache entry lifetime: 4 hours
# "Regenerate" on cached answers (single-use token issued only with a cache hit)
REGEN_TOKEN_TTL=900          # seconds a regenerate token stays valid
REGEN_MAX_PER_HOUR=20        # regenerations per user per hour
REGEN_EVICT_USERS=3          # distinct users regenerating a SHARED answer before it is evicted

# Dynamic Score-Based Retrieval
RETRIEVAL_DYNAMIC=true
RETRIEVAL_MIN_SIMILARITY=0.52
RETRIEVAL_SCORE_MARGIN=0.10
RETRIEVAL_MAX_KNEE_DROP=0.06
RETRIEVAL_EF_RUNTIME=64
# Rare query words ("What is known about GMRES?"): chunks containing a word found in <= RARE_MAX_CHUNKS chunks
# are accepted from RARE_MIN_SIMILARITY (if 2+ chunks of that thesis contain it, or it is in the title) and
# ranked with RARE_SCORE_BONUS. The global floor (RETRIEVAL_MIN_SIMILARITY) is unchanged. false = old behaviour.
RETRIEVAL_RARE_TERMS=true
RETRIEVAL_RARE_MAX_CHUNKS=2000
RETRIEVAL_RARE_MIN_SIMILARITY=0.30
RETRIEVAL_RARE_SCORE_BONUS=0.15
RETRIEVAL_RARE_MAX_ADDED=3
RETRIEVAL_RARE_MIN_DOC_CHUNKS=2

VLLM_BASE_URL=http://localhost:8000/v1
# Required: scripts/serve_vllm.py refuses to start without it, and every /v1/* call
# must send "Authorization: Bearer <key>". Generate: python -c 'import secrets;print(secrets.token_hex(32))'
VLLM_API_KEY=<GENERATE_A_RANDOM_HEX_KEY>
# GPU index the vLLM server runs on (CUDA_VISIBLE_DEVICES). Shared machine: pick a GPU with ~19 GB free.
VLLM_GPU=0
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

SLM_BASE_URL=http://localhost:8082/v1
SLM_MODEL_NAME=models/slm_gguf/qwen2.5-3b-instruct-q4_k_m.gguf
SLM_ENGINE=gguf
CPU_NUM_THREADS=16
# CPU SLM server: one process with SLM_SLOTS model slots (CPU_NUM_THREADS threads each).
# When no slot frees up within SLM_QUEUE_TIMEOUT seconds it answers 503 at once and the gateway
# overflows to the GPU tier; SLM_READ_TIMEOUT is the longest wait between streamed chunks.
SLM_SLOTS=6
SLM_QUEUE_TIMEOUT=3
SLM_READ_TIMEOUT=30
# A 3B refusal is re-asked to the 7B tier only for yes/no questions or when the best retrieved chunk
# has at least this similarity (relevant theses probably exist).
ESCALATE_MIN_SIMILARITY=0.65
CPU_BATCH_THREADS=32

ROUTING_ALPHA=0.65
COMPLEXITY_SCORER_PATH=gateway/router/models/scorer.onnx

GLOBAL_CONCURRENCY_LIMIT=30
PER_USER_CONCURRENCY_LIMIT=6
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

LOCAL_EMBEDDINGS_DIR=models/embeddings
LOCAL_SLM_GGUF_DIR=models/slm_gguf
LOCAL_LLM_7B_DIR=models/llm_7b
# Query-embedding CPU threads per gateway worker and embeddings in flight per worker (NFR-1 cache latency)
EMBED_NUM_THREADS=8
EMBED_CONCURRENCY=2
# Query/document embedding backend: auto = ONNX Runtime when models/embeddings/all-MiniLM-L6-v2/onnx/model.onnx
# exists (create it with: python scripts/export_embedder_onnx.py), else PyTorch. onnx | torch force one.
# Both give the same vectors (cosine >= 0.99999); ONNX is ~2x faster per query. EMBED_ORT_SPIN=1 lets idle
# ONNX threads spin (slightly lower latency, more CPU).
EMBED_BACKEND=auto
EMBED_ORT_SPIN=0
