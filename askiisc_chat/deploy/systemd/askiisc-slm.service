[Unit]
Description=AskIISc SLM (llama.cpp, CPU)
After=network.target

[Service]
User=askiisc
EnvironmentFile=/etc/askiisc/askiisc.env
ExecStart=/opt/askiisc/llama.cpp/build/bin/llama-server -m ${SLM_MODEL_PATH} --alias ${SLM_MODEL} \
  --host 127.0.0.1 --port 8002 -c ${SLM_CTX} --parallel 2 -t ${SLM_THREADS}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
