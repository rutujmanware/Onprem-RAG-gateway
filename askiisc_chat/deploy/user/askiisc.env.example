# ~/askiisc/askiisc.env  -  sourced by bash (deploy/user/askiisc.sh). KEY=value, no spaces around '=', comments on their own lines.
# Replace EVERY <PLACEHOLDER>. Generate secrets with: openssl rand -hex 24
# `hostname -I` shows the server's intranet IP.
BIND_HOST=<server-intranet-ip>
# Pick a free high port (ss -ltn | grep :9000). Your department admin must allow campus access to it.
BIND_PORT=9000
# Campus ranges WITHOUT guest/lab Wi-Fi. Default (unset) = loopback only = nobody else can connect.
ALLOWED_CIDRS=<cidr1>,<cidr2>
REQUIRE_LOGIN=0
# 0 only while the data holds NO restricted/embargoed theses
ACCESS_TIERS=0
SESSION_SECRET=<hex>

# Retrieval: "npz" = in-RAM index from chunks.npz (no Redis); "redis" = Redis Stack with RediSearch
RETRIEVER_BACKEND=npz
CHUNKS_FILE=$HOME/askiisc/data/chunks.npz
INDEX_NAME=idx:chunks
F_TEXT=text
F_VECTOR=embedding
F_THESIS_ID=thesis_id
TOP_K=6

# Embedder: must be the model that built the vectors (local folder, offline)
EMBED_BACKEND=sentence-transformers
EMBED_MODEL=$HOME/askiisc/models/bge-small-en-v1.5
EMBED_DIM=384
EMBED_QUERY_PREFIX=

# Services (shared server: pick ports nobody else uses; keys are MANDATORY because other local users can reach 127.0.0.1)
LLM_PORT=8000
LLM_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_MODEL_PATH=$HOME/askiisc/models/Qwen2.5-7B-Instruct
LLM_KEY=<hex1>
VLLM_API_KEY=<hex1>
# GPU is shared: check `nvidia-smi` for a GPU with enough FREE memory, then set GPU_ID and a utilisation that fits (fraction of TOTAL memory)
GPU_ID=0
VLLM_GPU_UTIL=0.90
VLLM_MAX_LEN=32768
SLM_PORT=8002
SLM_URL=http://127.0.0.1:8002/v1
SLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
SLM_MODEL_PATH=$HOME/askiisc/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
SLM_KEY=<hex2>
LLAMA_API_KEY=<hex2>
LLAMA_BIN=$HOME/askiisc/llama.cpp/llama-server
SLM_CTX=12288
SLM_THREADS=<number of cores you were allotted>
SLM_TOP_K=2
SLM_TIMEOUT=300

ROUTER_PATH=$HOME/askiisc/app/models/router.joblib
TRACE_FILE=$HOME/askiisc/logs/traces.jsonl
HF_HUB_OFFLINE=1
DO_NOT_TRACK=1
