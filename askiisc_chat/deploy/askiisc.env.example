# /etc/askiisc/askiisc.env   (chmod 640, owner root:askiisc). Secrets: generate with  openssl rand -hex 24
BIND_HOST=<server-intranet-ip>
BIND_PORT=9000
# EXCLUDE guest/lab Wi-Fi. Default allows only loopback = nobody else can connect.
ALLOWED_CIDRS=<staff/student ranges, e.g. 10.20.0.0/16>
# auth is a separate workstream; see README
REQUIRE_LOGIN=0
# 0 only while the index has NO restricted/embargoed theses
ACCESS_TIERS=0
SESSION_SECRET=<hex>

REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0
INDEX_NAME=rag_documents_idx
F_TEXT=text
F_VECTOR=embedding
F_THESIS_ID=thesis_id
TOP_K=6

# Embedder: must be the model that built the index. Local dir + offline.
EMBED_BACKEND=sentence-transformers
EMBED_MODEL=/opt/askiisc/models/all-MiniLM-L6-v2
EMBED_DIM=384
EMBED_QUERY_PREFIX=

# Models (all on loopback)
LLM_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_MODEL_PATH=/opt/askiisc/models/Qwen2.5-7B-Instruct
LLM_KEY=<hex1>
# same value as LLM_KEY (vLLM reads this env var, keeps it out of `ps`)
VLLM_API_KEY=<hex1>
SLM_URL=http://127.0.0.1:8082/v1
SLM_MODEL=Qwen/Qwen2.5-3B-Instruct
SLM_MODEL_PATH=/opt/askiisc/models/qwen2.5-3b-instruct-q4_k_m.gguf
SLM_KEY=<hex2>
# same value as SLM_KEY
LLAMA_API_KEY=<hex2>
# TOTAL context; split across --parallel slots (2 -> 6144 each)
SLM_CTX=12288
SLM_THREADS=<half your physical cores>
SLM_TOP_K=2
SLM_TIMEOUT=300

ROUTER_PATH=/opt/askiisc/app/models/router.joblib
TRACE_FILE=/var/lib/askiisc/traces.jsonl
HF_HUB_OFFLINE=1
DO_NOT_TRACK=1
