# Copy to app.env and edit. Comments must stay on their own lines.
# Where the app listens. 127.0.0.1 = this server only (reach it through the VS Code forwarded port). Use the server's intranet IP to open it to campus.
BIND_HOST=127.0.0.1
BIND_PORT=9000
# Network gate: ranges allowed to open the page at all. Keep 127.0.0.0/8 for the VS Code forward; add your campus ranges (10.192.12.63/32 is this server itself).
ALLOWED_CIDRS=127.0.0.0/8
# Sign-in with an email one-time code. Only addresses in these domains can sign in.
AUTH_MODE=otp
REQUIRE_LOGIN=1
ALLOWED_EMAIL_DOMAINS=iisc.ac.in
# DEMO ONLY: no mail relay, so the code is written to logs/app.log and read with ./app.sh code. Set to 0 once a real relay (SMTP_HOST) exists.
OTP_DEV_LOG=1
# 0 while the page is served over plain http. Set 1 behind https.
COOKIE_SECURE=0
# Run:  sed -i "s|^SESSION_SECRET=.*|SESSION_SECRET=$(python3 -c 'import secrets;print(secrets.token_hex(32))')|" app.env
SESSION_SECRET=CHANGE_ME
# Answers come from the team gateway (router + Redis retrieval + CPU SLM / 7B). It must listen on this URL.
BACKEND=gateway
GATEWAY_URL=http://127.0.0.1:18080
GATEWAY_TIMEOUT=600
MAX_TOKENS=300
# 1 = log the first raw events the gateway sends (use for the first runs, then set 0).
GATEWAY_DEBUG=1
