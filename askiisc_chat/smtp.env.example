# ==============================================================================
# SMTP Mail Relay Configuration for AskIISc OTP Verification
# ==============================================================================
# Copy this file to smtp.env and fill in your SMTP credentials:
#   cp smtp.env.example smtp.env
# ==============================================================================

# SMTP Server hostname or IP address (e.g. mail.iisc.ac.in, smtp.office365.com, or your relay IP)
SMTP_HOST=

# SMTP Port (587 for STARTTLS, 465 for SSL, 25 for internal relay)
SMTP_PORT=587

# Enable STARTTLS encryption (1 = enabled, 0 = disabled)
SMTP_STARTTLS=1

# Enable Direct SSL/TLS (1 = enabled for port 465, 0 = disabled)
SMTP_SSL=0

# SMTP Username / Mailbox (leave blank if unauthenticated relay)
SMTP_USER=

# SMTP Password / App Password (leave blank if unauthenticated relay)
SMTP_PASS=

# Sender address in "From:" header
SMTP_FROM=askiisc-noreply@iisc.ac.in

# Timeout in seconds
SMTP_TIMEOUT=60

# One-Time Passcode (OTP) Validity Lifetime in seconds (e.g. 180 = 3 minutes)
OTP_TTL=180


