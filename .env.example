HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=INFO

OIDC_ISSUER=https://auth.iisc.ac.in/auth/realms/campus
OIDC_CLIENT_ID=onprem-rag-gateway
OIDC_CLIENT_SECRET=change-me-secret-token
OIDC_JWKS_URL=https://auth.iisc.ac.in/auth/realms/campus/protocol/openid-connect/certs
OIDC_AUDIENCE=onprem-rag-gateway

ALLOWED_EMAIL_DOMAINS=iisc.ac.in
ADMIN_ROLES=cluster_admin,faculty_lead
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SESSION_SECRET=CHANGE_ME
COOKIE_SECURE=0
OTP_MAX_PER_HOUR=10
OTP_MAX_PER_IP_HOUR=1000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_INDEX_NAME=rag_documents_idx
SEMANTIC_CACHE_TTL=86400

# Dynamic Score-Based Retrieval
RETRIEVAL_DYNAMIC=true
RETRIEVAL_MIN_SIMILARITY=0.52
RETRIEVAL_SCORE_MARGIN=0.10
RETRIEVAL_MAX_KNEE_DROP=0.06
RETRIEVAL_EF_RUNTIME=64

VLLM_BASE_URL=http://localhost:8000/v1
# Required: scripts/serve_vllm.py refuses to start without it, and every /v1/* call
# must send "Authorization: Bearer <key>". Generate: python -c 'import secrets;print(secrets.token_hex(32))'
VLLM_API_KEY=<GENERATE_A_RANDOM_HEX_KEY>
# GPU index the vLLM server runs on (CUDA_VISIBLE_DEVICES). Shared machine: pick a GPU with ~19 GB free.
VLLM_GPU=0
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

SLM_BASE_URL=http://localhost:8082/v1
SLM_MODEL_NAME=models/slm_gguf/qwen2.5-3b-instruct-q4_k_m.gguf
SLM_ENGINE=gguf
CPU_NUM_THREADS=16
CPU_BATCH_THREADS=32

ROUTING_ALPHA=0.65
COMPLEXITY_SCORER_PATH=gateway/router/models/scorer.onnx

GLOBAL_CONCURRENCY_LIMIT=30
PER_USER_CONCURRENCY_LIMIT=6
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

LOCAL_EMBEDDINGS_DIR=models/embeddings
LOCAL_SLM_GGUF_DIR=models/slm_gguf
LOCAL_LLM_7B_DIR=models/llm_7b
