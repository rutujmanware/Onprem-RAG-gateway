# AskIISc Chat App Configuration for On-Premise RAG Gateway
# Where the app listens. 0.0.0.0 allows connections from campus/network.
BIND_HOST=0.0.0.0
BIND_PORT=9001

# Allowed CIDRs - allow local and intranet campus access
ALLOWED_CIDRS=127.0.0.0/8,10.0.0.0/8,0.0.0.0/0

# Sign-in settings (REQUIRE_LOGIN=1 enforces sign-in before chat is visible)
AUTH_MODE=otp
REQUIRE_LOGIN=1
ALLOWED_EMAIL_DOMAINS=iisc.ac.in
ALLOW_SUBDOMAINS=1
OTP_TTL=180
OTP_DEV_LOG=0
COOKIE_SECURE=0
SESSION_SECRET=4c3b36917c20b3ef1adf4fa6c8aad46f93d1fac2fc7345e19b484ae252fbe1e0

# Gateway integration (Connect to On-Premise RAG Gateway)
BACKEND=gateway
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_TIMEOUT=600
MAX_TOKENS=2048
GATEWAY_DEBUG=0

# Python environment
PY=/data2/home/ritujmanware/miniconda3/envs/rag_env/bin/python
