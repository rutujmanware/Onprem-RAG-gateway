# ==============================================================================
# SMTP Mail Relay Configuration for AskIISc OTP Verification
# ==============================================================================
# Copy this file to smtp.env and fill in your SMTP credentials:
#   cp smtp.env.example smtp.env
#
# Then test your settings anytime with:
#   python scripts/test_smtp.py your.name@iisc.ac.in
# ==============================================================================

# SMTP Server hostname or IP address (e.g. mail.iisc.ac.in, smtp.office365.com, or your relay IP)
SMTP_HOST=

# SMTP Port:
#  - 587 : Secure submission with STARTTLS (Standard for Office 365, Gmail, authenticated relays)
#  - 465 : Direct SSL/TLS encryption
#  - 25  : Internal intranet unauthenticated relay
SMTP_PORT=587

# Enable STARTTLS encryption (1 = enabled, 0 = disabled)
SMTP_STARTTLS=1

# Enable Direct SSL/TLS (1 = enabled for port 465, 0 = disabled)
SMTP_SSL=0

# SMTP Username / Mailbox (e.g. your email or relay service account username; leave empty if unauthenticated)
SMTP_USER=

# SMTP Password / App Password (leave empty if internal relay does not require authentication)
SMTP_PASS=

# Sender email address displayed to users in the "From:" header
SMTP_FROM=askiisc-noreply@iisc.ac.in

# Socket connection timeout in seconds
SMTP_TIMEOUT=15

# One-Time Passcode (OTP) Validity Lifetime in seconds (e.g. 180 = 3 minutes)
OTP_TTL=180


